# Desktop app backend configuration (loaded by desktop/app.go via godotenv)
#
# Transport resolution order (highest priority first):
#   1. USE_MOCK=true       -> in-process HTTP mock (frontend-only dev)
#   2. BACKEND_URL set     -> external HTTP backend (remote mode, no spawn)
#   3. otherwise           -> spawn the bundled backend in desktop/backend/
#
# NOTE: values exported by the Makefile (make dev-stdio / make dev-http) take
# precedence over these because dotenv never overrides existing environment
# variables.

# --- Frontend-only dev: in-process mock API (no backend process) ---
USE_MOCK=true

# --- Remote / external HTTP backend (no spawn) ---
# BACKEND_URL=http://localhost:4567

# --- Bundled backend spawn (default) ---
# Transport used by the spawned backend: http (default) | stdio
TRANSPORT=http

# Working data dir for the bundled backend (absolute path preferred; the
# Makefile passes an absolute path, relative values here are absolutized)
# APP_DATA_DIR=desktop/backend/data

# Where the bundled drizzle migrations live (auto-migrate on first run)
# APP_MIGRATIONS_DIR=desktop/backend/drizzle

# Port used when TRANSPORT=http
# BACKEND_PORT=4567